# ==============================================================================
# CaseBridge - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and customize values for your deployment environment.
# NEVER commit real secrets, salt values, or production passwords to version control.

# Core Runtime Environment (development, testing, or production)
FLASK_ENV=production

# Application HTTP Port (Default: 5000)
PORT=5000

# SECRET_KEY: Session signing key (Generate: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_secure_random_64_character_hex_key

# TRACKING_CODE_SALT: Cryptographic pepper salt used for irreversible SHA-256 tracking code hashing
TRACKING_CODE_SALT=change_me_to_a_secure_random_salt_never_hardcoded

# CASE_ENCRYPTION_KEY: 32-byte base64-encoded key for application-level field encryption (Fernet)
# (Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CASE_ENCRYPTION_KEY=change_me_to_a_secure_base64_32byte_key

# DATABASE_URL: MySQL 8.0 connection string
# Standard format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://casebridge_user:casebridge_secure_password@127.0.0.1:3306/casebridge_db

# Local Docker Compose Database Variables (used if running via docker compose)
MYSQL_DATABASE=casebridge_db
MYSQL_USER=casebridge_user
MYSQL_PASSWORD=change_me_to_a_secure_mysql_password
MYSQL_ROOT_PASSWORD=change_me_to_a_secure_root_password

# Rate Limiting Storage backend (memory:// for local dev/single worker, or redis://user:pass@host:port/0)
RATELIMIT_STORAGE_URI=memory://

# File Upload Constraints (FR-07/FR-08)
UPLOAD_FOLDER=instance/protected_uploads
MAX_CONTENT_LENGTH_MB=5

# Institutional Metadata
INSTITUTION_NAME=Metropolitan University Ethics & Case Office
SUPPORT_EMAIL=integrity-helpdesk@university.edu
PHONE_NUMBER=+92 42 99029216
EMERGENCY_PHONE=+92 42 99029216

# SMTP Email Configuration (Passwordless Staff OTP Login & Case Escalations)
# These variables must also be configured in Vercel for the deployed /api/send-otp function.
# For Gmail, use smtp.gmail.com and a Google App Password (not your normal password).
# ARK Ecosystem — CaseBridge mail dispatcher configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_USE_TLS=true
SMTP_FROM_NAME=ARK Ecosystem — CaseBridge
SMTP_FROM_EMAIL=your-sending-account@gmail.com
